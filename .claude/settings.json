{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/enforce-delegation.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-leverage.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/bl-tier-check.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/rt1-composition-gate.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/agent-role-tag.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/agent-context-check.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/in-session-fix-counter.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/rework-framing-detector.sh"
          }
        ]
      }
    ]
  }
}
