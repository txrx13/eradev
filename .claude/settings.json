{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/enforce-delegation.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/agent-role-tag.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/agent-context-check.sh"
          }
        ]
      }
    ]
  }
}
